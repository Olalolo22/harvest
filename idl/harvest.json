      "accounts": [
        { "name": "authority", "isMut": true, "isSigner": true },
        { "name": "xstockMint", "isMut": false, "isSigner": false },
        { "name": "usdcMint", "isMut": false, "isSigner": false },
        { "name": "vaultConfig", "isMut": true, "isSigner": false },
        { "name": "vaultXstockAta", "isMut": false, "isSigner": false },
        { "name": "vaultUsdcAta", "isMut": false, "isSigner": false },
        { "name": "tokenProgram", "isMut": false, "isSigner": false },
        { "name": "tokenProgramClassic", "isMut": false, "isSigner": false },
        { "name": "systemProgram", "isMut": false, "isSigner": false },
        { "name": "rent", "isMut": false, "isSigner": false }
      ],
      "args": [
        { "name": "ticker", "type": { "array": ["u8", 8] } },
        { "name": "strikeOffsetBps", "type": "u16" },
        { "name": "premiumRateBps", "type": "u16" },
        { "name": "cycleDurationSeconds", "type": "i64" }
      ]
    },
    {
      "name": "deposit",
      "accounts": [
        { "name": "owner", "isMut": true, "isSigner": true },
        { "name": "vaultConfig", "isMut": true, "isSigner": false },
        { "name": "xstockMint", "isMut": false, "isSigner": false },
        { "name": "userXstockAta", "isMut": true, "isSigner": false },
        { "name": "vaultXstockAta", "isMut": true, "isSigner": false },
        { "name": "userPosition", "isMut": true, "isSigner": false },
        { "name": "tokenProgram", "isMut": false, "isSigner": false },
        { "name": "systemProgram", "isMut": false, "isSigner": false }
      ],
      "args": [
        { "name": "amount", "type": "u64" }
      ]
    },
    {
      "name": "lockCycle",
      "accounts": [
        { "name": "authority", "isMut": false, "isSigner": true },
        { "name": "vaultConfig", "isMut": true, "isSigner": false }
      ],
      "args": [
        { "name": "currentPrice", "type": "i64" }
      ]
    },
    {
      "name": "settleOtm",
      "accounts": [
        { "name": "authority", "isMut": false, "isSigner": true },
        { "name": "vaultConfig", "isMut": true, "isSigner": false }
      ],
      "args": [
        { "name": "settlementPrice", "type": "i64" }
      ]
    },
    {
      "name": "settleItm",
      "accounts": [
        { "name": "authority", "isMut": true, "isSigner": true },
        { "name": "vaultConfig", "isMut": true, "isSigner": false },
        { "name": "keeperUsdcAta", "isMut": true, "isSigner": false },
        { "name": "vaultUsdcAta", "isMut": true, "isSigner": false },
        { "name": "tokenProgram", "isMut": false, "isSigner": false }
      ],
      "args": [
        { "name": "settlementPrice", "type": "i64" },
        { "name": "usdcProceeds", "type": "u64" }
      ]
    },
    {
      "name": "claim",
      "accounts": [
        { "name": "owner", "isMut": true, "isSigner": true },
        { "name": "vaultConfig", "isMut": true, "isSigner": false },
        { "name": "xstockMint", "isMut": false, "isSigner": false },
        { "name": "vaultXstockAta", "isMut": true, "isSigner": false },
        { "name": "userXstockAta", "isMut": true, "isSigner": false },
        { "name": "vaultUsdcAta", "isMut": true, "isSigner": false },
        { "name": "userUsdcAta", "isMut": true, "isSigner": false },
        { "name": "userPosition", "isMut": true, "isSigner": false },
        { "name": "tokenProgram2022", "isMut": false, "isSigner": false },
        { "name": "tokenProgram", "isMut": false, "isSigner": false }
      ],
      "args": []
    }
  ],
  "accounts": [
    {
      "name": "VaultConfig",
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "authority", "type": "publicKey" },
          { "name": "xstockMint", "type": "publicKey" },
          { "name": "ticker", "type": { "array": ["u8", 8] } },
          { "name": "xstockDecimals", "type": "u8" },
          { "name": "usdcMint", "type": "publicKey" },
          { "name": "vaultXstockAta", "type": "publicKey" },
          { "name": "vaultUsdcAta", "type": "publicKey" },
          { "name": "strikeOffsetBps", "type": "u16" },
          { "name": "premiumRateBps", "type": "u16" },
          { "name": "currentCycle", "type": "u64" },
          { "name": "cycleState", "type": { "defined": "CycleState" } },
          { "name": "strikePrice", "type": "i64" },
          { "name": "settlementPrice", "type": "i64" },
          { "name": "wasOtm", "type": "bool" },
          { "name": "itmUsdcProceeds", "type": "u64" },
          { "name": "cycleLockedAt", "type": "i64" },
          { "name": "settleAfter", "type": "i64" },
          { "name": "cycleDurationSeconds", "type": "i64" },
          { "name": "totalXstockDeposited", "type": "u64" },
          { "name": "pendingClaims", "type": "u32" },
          { "name": "totalPremiumDistributed", "type": "u64" },
          { "name": "bump", "type": "u8" }
        ]
      }
    },
    {
      "name": "UserPosition",
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "owner", "type": "publicKey" },
          { "name": "vault", "type": "publicKey" },
          { "name": "cycle", "type": "u64" },
          { "name": "xstockAmount", "type": "u64" },
          { "name": "depositValueUsd", "type": "u64" },
          { "name": "state", "type": { "defined": "PositionState" } },
          { "name": "depositedAt", "type": "i64" },
          { "name": "bump", "type": "u8" }
        ]
      }
    }
  ],
  "types": [
    {
      "name": "CycleState",
      "type": {
        "kind": "enum",
        "variants": [
          { "name": "AcceptingDeposits" },
          { "name": "CycleLocked" },
          { "name": "Settled" }
        ]
      }
    },
    {
      "name": "PositionState",
      "type": {
        "kind": "enum",
        "variants": [
          { "name": "Active" },
          { "name": "ReadyToClaim" },
          { "name": "Claimed" }
        ]
      }
    }
  ],
  "errors": [
    { "code": 6000, "name": "VaultNotAcceptingDeposits", "msg": "Vault is not currently accepting deposits" },
    { "code": 6001, "name": "CycleNotLocked", "msg": "Cycle is not locked — cannot settle yet" },
    { "code": 6002, "name": "TooEarlyToSettle", "msg": "Settlement window has not opened yet — too early to settle" },
    { "code": 6003, "name": "NotOtm", "msg": "OTM condition not met — settlement price is at or above strike" },
    { "code": 6004, "name": "NotItm", "msg": "ITM condition not met — settlement price is below strike" },
    { "code": 6005, "name": "CycleMismatch", "msg": "Position cycle does not match current vault cycle" },
    { "code": 6006, "name": "AlreadyClaimed", "msg": "Position has already been claimed" },
    { "code": 6007, "name": "VaultNotSettled", "msg": "Position is not ready to claim — vault not settled yet" },
    { "code": 6008, "name": "ZeroDepositAmount", "msg": "Deposit amount must be greater than zero" },
    { "code": 6009, "name": "DepositBelowMinimum", "msg": "Deposit amount is below the minimum allowed" },
    { "code": 6010, "name": "InsufficientPremiumReserve", "msg": "USDC premium reserve is insufficient — admin must top up vault_usdc_ata" },
    { "code": 6011, "name": "PremiumRateTooHigh", "msg": "Premium rate exceeds the maximum allowed (1000 bps = 10%)" },
    { "code": 6012, "name": "StrikeOffsetTooHigh", "msg": "Strike offset exceeds the maximum allowed (2000 bps = 20%)" },
    { "code": 6013, "name": "MathOverflow", "msg": "Arithmetic overflow in price or premium calculation" },
    { "code": 6014, "name": "InvalidPrice", "msg": "Price passed by keeper is non-positive — invalid Pyth reading" },
    { "code": 6015, "name": "InvalidCycleDuration", "msg": "Cycle duration must be positive" },
    { "code": 6016, "name": "Unauthorized", "msg": "Caller is not the vault authority" }
  ],
  "metadata": {
    "address": "34Y7acmqWosmkfPJjqRUQzrHFdxmxpQezLSvgD9bLJJo"
  }
